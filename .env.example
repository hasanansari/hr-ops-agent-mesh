# ─────────────────────────────────────────────────────────────────────────────
# LLM Provider — controls which backend the Policy Agent RAG step uses.
# All other agents (anomaly detection, bandit, compliance) make zero LLM calls.
#
# Options: anthropic (default) | openai | ollama
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic (default provider)
# Get your key at: https://console.anthropic.com
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI  (set LLM_PROVIDER=openai to activate)
# Requires: uv add openai
# Get your key at: https://platform.openai.com
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o

# ─────────────────────────────────────────────────────────────────────────────
# Ollama  (set LLM_PROVIDER=ollama to activate — no API key needed)
# Requires: uv add openai  +  Ollama running locally (https://ollama.com)
# Pull a model first: ollama pull llama3
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# ─────────────────────────────────────────────────────────────────────────────
# HITL tuning (optional — demo defaults shown)
# ─────────────────────────────────────────────────────────────────────────────
HITL_TIMEOUT_SECONDS=120
HITL_POLL_INTERVAL_SECONDS=2
